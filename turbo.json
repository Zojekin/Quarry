{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["product-info.json", "package.json"],
  "tasks": {
    "build": {
      "env": ["VITE_API_URL"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    }
  }
}
