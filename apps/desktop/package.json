{
  "name": "@quarry/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/runtime/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "node scripts/restore-sqlite.cjs",
    "test": "vitest run",
    "predev": "node scripts/restore-sqlite.cjs",
    "dev": "node scripts/bundle.mjs && electron .",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "prepack": "pnpm --filter @quarry/web build && pnpm build",
    "postpack": "node scripts/restore-sqlite.cjs",
    "predist": "pnpm --filter @quarry/web build && pnpm build",
    "postdist": "node scripts/restore-sqlite.cjs"
  },
  "dependencies": {
    "@quarry/shared": "workspace:*",
    "@quarry/server": "workspace:*",
    "@quarry/database": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.4.1",
    "kysely": "^0.28.19"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "productName": "题匣",
    "executableName": "Quarry",
    "appId": "com.quarry.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/runtime/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "beforePack": "./scripts/before-pack.cjs",
    "win": {
      "icon": "resources/icon.ico",
      "artifactName": "Quarry-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Quarry-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "selectPerMachineByDefault": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "题匣",
      "uninstallDisplayName": "题匣",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "language": "2052"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false
  }
}
