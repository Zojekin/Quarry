{
  "name": "@quarry/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/runtime/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "node scripts/bundle.mjs && electron .",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "prepack": "pnpm --filter @quarry/web build && pnpm build",
    "predist": "pnpm --filter @quarry/web build && pnpm build"
  },
  "dependencies": {
    "@quarry/shared": "workspace:*",
    "@quarry/server": "workspace:*",
    "@quarry/database": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.4.1",
    "kysely": "^0.28.19"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "productName": "题匣",
    "appId": "com.quarry.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/runtime/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "beforePack": "./scripts/before-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": true
  }
}
